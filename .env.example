# Speech-to-text provider: whisper | google (google is not implemented yet)
EXPO_PUBLIC_STT_PROVIDER=whisper
# Dev only. For production use a proxy and leave this empty.
EXPO_PUBLIC_OPENAI_API_KEY=
# Optional: your own endpoint that accepts the same multipart upload as OpenAI's /v1/audio/transcriptions
EXPO_PUBLIC_STT_PROXY_URL=

# Supabase (Dashboard -> Project Settings -> API). Leave blank to use the local mock backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
